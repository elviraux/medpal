// Copy this file to Secrets.xcconfig. Do not commit the copy.
// These are the existing Expo app's EXPO_PUBLIC_NEWELL_API_URL and
// EXPO_PUBLIC_PROJECT_ID. The EAS project ID is a different identifier.
// xcconfig treats // as a comment, hence the empty expansion in the URL.
NEWELL_API_URL = https:/$()/newell.fastshot.ai
FASTSHOT_PROJECT_ID =

// Optional: use the existing App Store Connect subscription product IDs.
// Prices and trial eligibility always come from StoreKit, never hardcoded copy.
SLIMSY_MONTHLY_PRODUCT_ID =
SLIMSY_YEARLY_PRODUCT_ID =

// Same public SDK key as EXPO_PUBLIC_ADAPTY_API_KEY in the original app.
ADAPTY_PUBLIC_SDK_KEY =
ADAPTY_PLACEMENT_ID = default
